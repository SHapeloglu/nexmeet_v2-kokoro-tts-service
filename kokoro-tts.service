[Unit]
Description=KokoClone TTS Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/kokoro-tts-service
Environment="PATH=/home/ubuntu/kokoro-tts-service/venv/bin"
EnvironmentFile=/home/ubuntu/kokoro-tts-service/.env
ExecStart=/home/ubuntu/kokoro-tts-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
